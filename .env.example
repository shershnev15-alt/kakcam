# Local development only. Copy to .env if values need to be overridden.
NODE_ENV=development
POSTGRES_DB=arena_passport
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena_local_only
DATABASE_URL=postgresql://arena:arena_local_only@postgres:5432/arena_passport?schema=public
REDIS_URL=redis://redis:6379
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
IP_HASH_SALT=arena-local-ip-salt-change-me
METRICS_TOKEN=arena-local-metrics-token
LOG_LEVEL=info

# Optional game-account integrations. Without keys the API stays available in explicit DEMO mode
# and never marks an account as verified.
STEAM_WEB_API_KEY=
STEAM_API_BASE_URL=https://api.steampowered.com
FACEIT_API_KEY=
PUBLIC_WEB_URL=http://localhost:3000
EMAIL_DELIVERY_ENDPOINT=
EMAIL_DELIVERY_TOKEN=
IDENTITY_VERIFICATION_PROVIDER=
IDENTITY_VERIFICATION_API_KEY=
IDENTITY_VERIFICATION_WEBHOOK_SECRET=
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
FACEIT_API_BASE_URL=https://open.faceit.com/data/v4
