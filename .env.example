# Local development only. Copy to .env if values need to be overridden.
NODE_ENV=development
POSTGRES_DB=arena_passport
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena_local_only
DATABASE_URL=postgresql://arena:arena_local_only@postgres:5432/arena_passport?schema=public
REDIS_URL=redis://redis:6379
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
IP_HASH_SALT=arena-local-ip-salt-change-me
METRICS_TOKEN=arena-local-metrics-token
LOG_LEVEL=info
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Transactional email. EMAIL_FROM must use a domain verified by the provider.
RESEND_API_KEY=
EMAIL_FROM=cyberID <verify@example.com>

# Steam OpenID proves ownership. The Web API key is optional and enriches the public handle.
STEAM_OPENID_REALM=http://localhost:4000/
STEAM_WEB_API_KEY=
STEAM_API_BASE_URL=https://api.steampowered.com

# FACEIT OAuth Authorization Code + PKCE.
FACEIT_OAUTH_CLIENT_ID=
FACEIT_OAUTH_CLIENT_SECRET=
FACEIT_OAUTH_STATE_SECRET=
FACEIT_API_KEY=
FACEIT_API_BASE_URL=https://open.faceit.com/data/v4

# Private evidence storage. Use a 32-byte hex or base64 key from a secret manager.
EVIDENCE_ENCRYPTION_KEY=
PRIVATE_UPLOAD_ROOT=../../.data/private-evidence
PUBLIC_MEDIA_ROOT=../../.data/public-media/players
MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_TOKEN=

# Sumsub document + face match + liveness.
SUMSUB_API_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=

# Generic email webhook fallback retained for another transactional provider.
EMAIL_DELIVERY_ENDPOINT=
EMAIL_DELIVERY_TOKEN=
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
