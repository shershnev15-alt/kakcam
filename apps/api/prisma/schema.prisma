generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityProvider {
  EMAIL
  STEAM
  GOOGLE
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

enum MemberFunction {
  PLAYER
  SUBSTITUTE
  COACH
  MANAGER
}

enum TransferStatus {
  RUMOR
  REPORTED
  CONFIRMED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum DataImportStatus {
  QUEUED
  FETCHING
  MAPPING
  VALIDATING
  REVIEW
  APPLYING
  COMPLETED
  FAILED
}

enum AssertionStatus {
  CANDIDATE
  EFFECTIVE
  CONFLICTED
  REJECTED
  SUPERSEDED
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum RatingEngine {
  PPR
  TPR
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  displayName     String?
  locale          String         @default("ru")
  status          UserStatus     @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  follows         UserFollow[]
  notifications   Notification[]
  auditLogs       AuditLog[]     @relation("AuditActor")
  identities      Identity[]
  sessions        Session[]
  roles           UserRole[]     @relation("UserRoleSubject")
  grantedRoles    UserRole[]     @relation("UserRoleGrantor")
}

model Identity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  provider        IdentityProvider
  providerSubject String
  passwordHash    String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?   @db.VarChar(512)
  ipHash     String?   @db.VarChar(64)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt, expiresAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  scopeType   String?
  scopeId     String?   @db.Uuid
  grantedById String?   @db.Uuid
  validUntil  DateTime?
  user        User      @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("UserRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([userId, validUntil])
  @@index([roleId])
  @@index([scopeType, scopeId])
}

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(2)
  name      String
  players   Player[]
  teams     Team[]
  createdAt DateTime @default(now())
}

model Game {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique
  name        String
  status      EntityStatus        @default(ACTIVE)
  roles       GameRole[]
  accounts    PlayerGameAccount[]
  matches     Match[]
  tournaments Tournament[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model GameRole {
  id     String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  slug   String
  name   String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slug])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  countryCode String?
  website     String?
  teams       Team[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Player {
  id                         String                 @id @default(uuid()) @db.Uuid
  slug                       String                 @unique
  nickname                   String
  normalizedNickname         String
  countryId                  String?                @db.Uuid
  currentTeamId              String?                @db.Uuid
  status                     EntityStatus           @default(ACTIVE)
  aggregateVerificationLevel Int                    @default(0)
  country                    Country?               @relation(fields: [countryId], references: [id])
  currentTeam                Team?                  @relation("CurrentPlayers", fields: [currentTeamId], references: [id])
  profile                    PlayerProfile?
  accounts                   PlayerGameAccount[]
  memberships                TeamMember[]
  ratings                    PlayerRating[]
  achievements               PlayerAchievement[]
  statistics                 PlayerMatchStatistic[]
  career                     CareerHistory[]
  transfers                  Transfer[]
  followers                  UserFollow[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([normalizedNickname])
  @@index([countryId, status])
}

model PlayerProfile {
  playerId    String    @id @db.Uuid
  realName    String?
  birthDate   DateTime? @db.Date
  regionName  String?
  bio         String?
  avatarUrl   String?
  socialLinks Json?
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt
}

model PlayerGameAccount {
  id         String    @id @default(uuid()) @db.Uuid
  playerId   String    @db.Uuid
  gameId     String    @db.Uuid
  provider   String
  externalId String
  handle     String?
  verifiedAt DateTime?
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game       Game      @relation(fields: [gameId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([playerId, gameId])
}

model Team {
  id                         String            @id @default(uuid()) @db.Uuid
  slug                       String            @unique
  name                       String
  shortName                  String
  countryId                  String?           @db.Uuid
  organizationId             String?           @db.Uuid
  foundedAt                  DateTime?         @db.Date
  logoUrl                    String?
  status                     EntityStatus      @default(ACTIVE)
  aggregateVerificationLevel Int               @default(0)
  country                    Country?          @relation(fields: [countryId], references: [id])
  organization               Organization?     @relation(fields: [organizationId], references: [id])
  currentPlayers             Player[]          @relation("CurrentPlayers")
  rosters                    TeamRoster[]
  ratings                    TeamRating[]
  achievements               TeamAchievement[]
  homeMatches                Match[]           @relation("HomeTeam")
  awayMatches                Match[]           @relation("AwayTeam")
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([countryId, status])
}

model TeamRoster {
  id        String       @id @default(uuid()) @db.Uuid
  teamId    String       @db.Uuid
  gameId    String       @db.Uuid
  name      String
  validFrom DateTime     @db.Date
  validTo   DateTime?    @db.Date
  isActive  Boolean      @default(true)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  createdAt DateTime     @default(now())

  @@index([teamId, gameId, isActive])
}

model TeamMember {
  id       String         @id @default(uuid()) @db.Uuid
  rosterId String         @db.Uuid
  playerId String         @db.Uuid
  function MemberFunction @default(PLAYER)
  joinedAt DateTime       @db.Date
  leftAt   DateTime?      @db.Date
  roster   TeamRoster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  player   Player         @relation(fields: [playerId], references: [id])

  @@index([rosterId, function])
  @@index([playerId, joinedAt])
}

model Tournament {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  gameId    String   @db.Uuid
  name      String
  tier      String
  mode      String
  startsAt  DateTime
  endsAt    DateTime
  prizePool Decimal? @db.Decimal(14, 2)
  currency  String?  @db.VarChar(3)
  game      Game     @relation(fields: [gameId], references: [id])
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId, startsAt])
}

model Match {
  id                String                 @id @default(uuid()) @db.Uuid
  gameId            String                 @db.Uuid
  tournamentId      String?                @db.Uuid
  homeTeamId        String?                @db.Uuid
  awayTeamId        String?                @db.Uuid
  startsAt          DateTime
  status            MatchStatus            @default(SCHEDULED)
  stage             String?
  bestOf            Int                    @default(1)
  homeScore         Int?
  awayScore         Int?
  verificationLevel Int                    @default(0)
  game              Game                   @relation(fields: [gameId], references: [id])
  tournament        Tournament?            @relation(fields: [tournamentId], references: [id])
  homeTeam          Team?                  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam          Team?                  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  statistics        PlayerMatchStatistic[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status, startsAt])
  @@index([tournamentId, startsAt])
}

model PlayerMatchStatistic {
  id            String   @id @default(uuid()) @db.Uuid
  playerId      String   @db.Uuid
  matchId       String   @db.Uuid
  mapKey        String   @default("all")
  kills         Int?
  deaths        Int?
  assists       Int?
  rounds        Int?
  metrics       Json
  schemaVersion Int      @default(1)
  player        Player   @relation(fields: [playerId], references: [id])
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([playerId, matchId, mapKey])
}

model RatingRun {
  id             String       @id @default(uuid()) @db.Uuid
  engine         RatingEngine
  formulaVersion String
  inputCutoff    DateTime
  checksum       String
  status         String
  config         Json
  createdAt      DateTime     @default(now())

  @@unique([engine, formulaVersion, inputCutoff])
}

model PlayerRating {
  id          String   @id @default(uuid()) @db.Uuid
  playerId    String   @db.Uuid
  gameId      String   @db.Uuid
  runId       String   @db.Uuid
  score       Int
  confidence  Decimal  @db.Decimal(5, 2)
  rank        Int?
  explanation Json
  publishedAt DateTime
  player      Player   @relation(fields: [playerId], references: [id])

  @@unique([playerId, gameId, runId])
  @@index([gameId, score(sort: Desc)])
}

model TeamRating {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @db.Uuid
  gameId      String   @db.Uuid
  runId       String   @db.Uuid
  score       Int
  confidence  Decimal  @db.Decimal(5, 2)
  rank        Int?
  explanation Json
  publishedAt DateTime
  team        Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, gameId, runId])
  @@index([gameId, score(sort: Desc)])
}

model Achievement {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  gameId       String?             @db.Uuid
  title        String
  description  String
  category     String
  rarity       AchievementRarity
  ruleVersion  Int                 @default(1)
  rule         Json
  icon         String
  playerGrants PlayerAchievement[]
  teamGrants   TeamAchievement[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model PlayerAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  playerId      String      @db.Uuid
  achievementId String      @db.Uuid
  progress      Decimal     @db.Decimal(12, 2)
  target        Decimal     @db.Decimal(12, 2)
  grantedAt     DateTime?
  sourceId      String?     @db.Uuid
  status        String
  evidence      Json?
  player        Player      @relation(fields: [playerId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([playerId, achievementId])
}

model TeamAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  teamId        String      @db.Uuid
  achievementId String      @db.Uuid
  progress      Decimal     @db.Decimal(12, 2)
  target        Decimal     @db.Decimal(12, 2)
  grantedAt     DateTime?
  status        String
  team          Team        @relation(fields: [teamId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([teamId, achievementId])
}

model Transfer {
  id           String         @id @default(uuid()) @db.Uuid
  playerId     String         @db.Uuid
  fromTeamId   String?        @db.Uuid
  toTeamId     String?        @db.Uuid
  transferDate DateTime       @db.Date
  status       TransferStatus
  sourceId     String?        @db.Uuid
  player       Player         @relation(fields: [playerId], references: [id])
  createdAt    DateTime       @default(now())

  @@index([status, transferDate])
}

model CareerHistory {
  id        String    @id @default(uuid()) @db.Uuid
  playerId  String    @db.Uuid
  teamId    String?   @db.Uuid
  gameId    String    @db.Uuid
  role      String?
  startedAt DateTime  @db.Date
  endedAt   DateTime? @db.Date
  sourceId  String?   @db.Uuid
  player    Player    @relation(fields: [playerId], references: [id])

  @@index([playerId, startedAt])
}

model DataSource {
  id         String       @id @default(uuid()) @db.Uuid
  code       String       @unique
  name       String
  type       String
  trustLevel Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  imports    DataImport[]
}

model DataImport {
  id          String           @id @default(uuid()) @db.Uuid
  sourceId    String           @db.Uuid
  externalKey String?
  checksum    String
  status      DataImportStatus
  rawLocation String?
  counters    Json?
  errors      Json?
  source      DataSource       @relation(fields: [sourceId], references: [id])
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  @@unique([sourceId, checksum])
}

model FieldAssertion {
  id                String          @id @default(uuid()) @db.Uuid
  entityType        String
  entityId          String          @db.Uuid
  fieldPath         String
  value             Json
  sourceId          String?         @db.Uuid
  authorId          String?         @db.Uuid
  observedAt        DateTime
  verificationLevel Int             @default(0)
  status            AssertionStatus @default(CANDIDATE)
  createdAt         DateTime        @default(now())

  @@index([entityType, entityId, fieldPath, status])
}

model Verification {
  id          String             @id @default(uuid()) @db.Uuid
  subjectType String
  subjectId   String             @db.Uuid
  level       Int
  method      String
  status      VerificationStatus @default(PENDING)
  reviewerId  String?            @db.Uuid
  reason      String?
  validUntil  DateTime?
  createdAt   DateTime           @default(now())
  decidedAt   DateTime?

  @@index([subjectType, subjectId, status])
}

model UserFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  playerId  String?  @db.Uuid
  teamId    String?  @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  topic     String
  payload   Json
  status    NotificationStatus @default(PENDING)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  @@index([userId, status, createdAt])
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  summary     String?
  body        Json
  status      ContentStatus @default(DRAFT)
  authorId    String?       @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Report {
  id         String    @id @default(uuid()) @db.Uuid
  reporterId String?   @db.Uuid
  targetType String
  targetId   String    @db.Uuid
  category   String
  details    String?
  status     String    @default("OPEN")
  resolution String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  reason     String?
  diff       Json?
  requestId  String?
  ipHash     String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
