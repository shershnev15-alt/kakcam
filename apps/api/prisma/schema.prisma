generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityProvider {
  EMAIL
  STEAM
  GOOGLE
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

enum MemberFunction {
  PLAYER
  SUBSTITUTE
  COACH
  MANAGER
}

enum TransferStatus {
  RUMOR
  REPORTED
  CONFIRMED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum DataImportStatus {
  QUEUED
  FETCHING
  MAPPING
  VALIDATING
  REVIEW
  APPLYING
  COMPLETED
  FAILED
}

enum DataImportRecordStatus {
  STAGED
  VALID
  INVALID
  APPLIED
  SKIPPED
}

enum AssertionStatus {
  CANDIDATE
  EFFECTIVE
  CONFLICTED
  REJECTED
  SUPERSEDED
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum RatingEngine {
  PPR
  TPR
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  displayName           String?
  locale                String                 @default("ru")
  status                UserStatus             @default(ACTIVE)
  emailVerifiedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  follows               UserFollow[]
  notifications         Notification[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  identities            Identity[]
  sessions              Session[]
  roles                 UserRole[]             @relation("UserRoleSubject")
  grantedRoles          UserRole[]             @relation("UserRoleGrantor")
  profileClaims         ProfileClaim[]         @relation("Claimant")
  reviewedClaims        ProfileClaim[]         @relation("ClaimReviewer")
  submittedEvidence     VerificationEvidence[] @relation("EvidenceSubmitter")
  reviewedVerifications Verification[]         @relation("VerificationReviewer")
  moderationCases       ModerationCase[]       @relation("ModerationAssignee")
}

model Identity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  provider        IdentityProvider
  providerSubject String
  passwordHash    String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?   @db.VarChar(512)
  ipHash     String?   @db.VarChar(64)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt, expiresAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  scopeType   String?
  scopeId     String?   @db.Uuid
  grantedById String?   @db.Uuid
  validUntil  DateTime?
  user        User      @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("UserRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([userId, validUntil])
  @@index([roleId])
  @@index([scopeType, scopeId])
}

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(2)
  name      String
  players   Player[]
  teams     Team[]
  createdAt DateTime @default(now())
}

model Game {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique
  name        String
  status      EntityStatus        @default(ACTIVE)
  roles       GameRole[]
  accounts    PlayerGameAccount[]
  matches     Match[]
  tournaments Tournament[]
  career      CareerHistory[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model GameRole {
  id     String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  slug   String
  name   String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slug])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  countryCode String?
  website     String?
  teams       Team[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Player {
  id                         String                      @id @default(uuid()) @db.Uuid
  slug                       String                      @unique
  nickname                   String
  normalizedNickname         String
  countryId                  String?                     @db.Uuid
  currentTeamId              String?                     @db.Uuid
  status                     EntityStatus                @default(ACTIVE)
  aggregateVerificationLevel Int                         @default(0)
  country                    Country?                    @relation(fields: [countryId], references: [id])
  currentTeam                Team?                       @relation("CurrentPlayers", fields: [currentTeamId], references: [id])
  profile                    PlayerProfile?
  accounts                   PlayerGameAccount[]
  memberships                TeamMember[]
  ratings                    PlayerRating[]
  achievements               PlayerAchievement[]
  statistics                 PlayerMatchStatistic[]
  aggregateStatistics        PlayerStatistic[]
  tournamentStatistics       PlayerTournamentStatistic[]
  career                     CareerHistory[]
  transfers                  Transfer[]
  claims                     ProfileClaim[]
  followers                  UserFollow[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([normalizedNickname])
  @@index([countryId, status])
}

model PlayerProfile {
  playerId    String    @id @db.Uuid
  realName    String?
  birthDate   DateTime? @db.Date
  regionName  String?
  bio         String?
  avatarUrl   String?
  socialLinks Json?
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt
}

model PlayerGameAccount {
  id         String    @id @default(uuid()) @db.Uuid
  playerId   String    @db.Uuid
  gameId     String    @db.Uuid
  provider   String
  externalId String
  handle     String?
  verifiedAt DateTime?
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game       Game      @relation(fields: [gameId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([playerId, gameId])
}

model Team {
  id                         String                  @id @default(uuid()) @db.Uuid
  slug                       String                  @unique
  name                       String
  shortName                  String
  countryId                  String?                 @db.Uuid
  organizationId             String?                 @db.Uuid
  foundedAt                  DateTime?               @db.Date
  logoUrl                    String?
  status                     EntityStatus            @default(ACTIVE)
  aggregateVerificationLevel Int                     @default(0)
  country                    Country?                @relation(fields: [countryId], references: [id])
  organization               Organization?           @relation(fields: [organizationId], references: [id])
  currentPlayers             Player[]                @relation("CurrentPlayers")
  rosters                    TeamRoster[]
  ratings                    TeamRating[]
  achievements               TeamAchievement[]
  homeMatches                Match[]                 @relation("HomeTeam")
  awayMatches                Match[]                 @relation("AwayTeam")
  aggregateStatistics        TeamStatistic[]
  tournamentParticipants     TournamentParticipant[]
  tournamentPlacements       TournamentPlacement[]
  outgoingTransfers          Transfer[]              @relation("TransferFromTeam")
  incomingTransfers          Transfer[]              @relation("TransferToTeam")
  careerHistory              CareerHistory[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([countryId, status])
}

model TeamRoster {
  id        String       @id @default(uuid()) @db.Uuid
  teamId    String       @db.Uuid
  gameId    String       @db.Uuid
  name      String
  validFrom DateTime     @db.Date
  validTo   DateTime?    @db.Date
  isActive  Boolean      @default(true)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  createdAt DateTime     @default(now())

  @@index([teamId, gameId, isActive])
}

model TeamMember {
  id       String         @id @default(uuid()) @db.Uuid
  rosterId String         @db.Uuid
  playerId String         @db.Uuid
  function MemberFunction @default(PLAYER)
  joinedAt DateTime       @db.Date
  leftAt   DateTime?      @db.Date
  roster   TeamRoster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  player   Player         @relation(fields: [playerId], references: [id])

  @@index([rosterId, function])
  @@index([playerId, joinedAt])
}

model Tournament {
  id               String                      @id @default(uuid()) @db.Uuid
  slug             String                      @unique
  gameId           String                      @db.Uuid
  name             String
  tier             String
  mode             String
  startsAt         DateTime
  endsAt           DateTime
  prizePool        Decimal?                    @db.Decimal(14, 2)
  currency         String?                     @db.VarChar(3)
  game             Game                        @relation(fields: [gameId], references: [id])
  matches          Match[]
  participants     TournamentParticipant[]
  placements       TournamentPlacement[]
  playerStatistics PlayerTournamentStatistic[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([gameId, startsAt])
}

model Match {
  id                String                 @id @default(uuid()) @db.Uuid
  gameId            String                 @db.Uuid
  tournamentId      String?                @db.Uuid
  homeTeamId        String?                @db.Uuid
  awayTeamId        String?                @db.Uuid
  startsAt          DateTime
  status            MatchStatus            @default(SCHEDULED)
  stage             String?
  bestOf            Int                    @default(1)
  homeScore         Int?
  awayScore         Int?
  verificationLevel Int                    @default(0)
  sourceCode        String                 @default("arena-demo")
  observedAt        DateTime               @default(now())
  finalizedAt       DateTime?
  game              Game                   @relation(fields: [gameId], references: [id])
  tournament        Tournament?            @relation(fields: [tournamentId], references: [id])
  homeTeam          Team?                  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam          Team?                  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  statistics        PlayerMatchStatistic[]
  maps              MatchMap[]
  result            MatchResult?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status, startsAt])
  @@index([tournamentId, startsAt])
}

model PlayerMatchStatistic {
  id                String    @id @default(uuid()) @db.Uuid
  playerId          String    @db.Uuid
  matchId           String    @db.Uuid
  mapKey            String    @default("all")
  kills             Int?
  deaths            Int?
  assists           Int?
  rounds            Int?
  teamId            String?   @db.Uuid
  opponentTeamId    String?   @db.Uuid
  performanceRating Decimal?  @db.Decimal(6, 3)
  adr               Decimal?  @db.Decimal(7, 2)
  kast              Decimal?  @db.Decimal(5, 2)
  impact            Decimal?  @db.Decimal(6, 3)
  headshotRate      Decimal?  @db.Decimal(5, 2)
  openingDuelRate   Decimal?  @db.Decimal(5, 2)
  verifiedAt        DateTime?
  sourceCode        String    @default("arena-demo")
  metrics           Json
  schemaVersion     Int       @default(1)
  player            Player    @relation(fields: [playerId], references: [id])
  match             Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@unique([playerId, matchId, mapKey])
  @@index([matchId, teamId])
}

model MatchMap {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  mapKey    String
  mapOrder  Int
  homeScore Int?
  awayScore Int?
  overtime  Boolean  @default(false)
  status    String   @default("SCHEDULED")
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, mapOrder])
  @@index([mapKey, status])
}

model MatchResult {
  id           String   @id @default(uuid()) @db.Uuid
  matchId      String   @unique @db.Uuid
  winnerTeamId String?  @db.Uuid
  homeScore    Int
  awayScore    Int
  checksum     String   @db.VarChar(64)
  sourceCode   String
  finalizedAt  DateTime
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model TournamentParticipant {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  teamId       String     @db.Uuid
  seed         Int?
  status       String     @default("ACTIVE")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, teamId])
  @@index([teamId, status])
}

model TournamentPlacement {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  teamId       String     @db.Uuid
  placeFrom    Int
  placeTo      Int
  prizeAmount  Decimal?   @db.Decimal(14, 2)
  points       Decimal?   @db.Decimal(10, 2)
  verifiedAt   DateTime?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, teamId])
  @@index([teamId, placeFrom])
}

model PlayerStatistic {
  id            String   @id @default(uuid()) @db.Uuid
  playerId      String   @db.Uuid
  gameId        String   @db.Uuid
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  sampleMatches Int
  sampleMaps    Int
  rounds        Int
  kills         Int
  deaths        Int
  assists       Int
  wins          Int
  losses        Int
  metrics       Json
  schemaVersion Int      @default(1)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([playerId, gameId, periodStart, periodEnd])
  @@index([gameId, periodEnd])
}

model PlayerTournamentStatistic {
  id            String     @id @default(uuid()) @db.Uuid
  playerId      String     @db.Uuid
  tournamentId  String     @db.Uuid
  sampleMatches Int
  sampleMaps    Int
  kills         Int
  deaths        Int
  assists       Int
  metrics       Json
  schemaVersion Int        @default(1)
  player        Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([playerId, tournamentId])
  @@index([tournamentId, kills])
}

model TeamStatistic {
  id            String   @id @default(uuid()) @db.Uuid
  teamId        String   @db.Uuid
  gameId        String   @db.Uuid
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  sampleMatches Int
  wins          Int
  losses        Int
  mapsWon       Int
  mapsLost      Int
  roundsWon     Int
  roundsLost    Int
  metrics       Json
  schemaVersion Int      @default(1)
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamId, gameId, periodStart, periodEnd])
  @@index([gameId, periodEnd])
}

model RatingRun {
  id             String         @id @default(uuid()) @db.Uuid
  engine         RatingEngine
  formulaVersion String
  inputCutoff    DateTime
  checksum       String
  status         String
  config         Json
  createdAt      DateTime       @default(now())
  playerRatings  PlayerRating[]
  teamRatings    TeamRating[]

  @@unique([engine, formulaVersion, inputCutoff])
}

model PlayerRating {
  id          String    @id @default(uuid()) @db.Uuid
  playerId    String    @db.Uuid
  gameId      String    @db.Uuid
  runId       String    @db.Uuid
  score       Int
  confidence  Decimal   @db.Decimal(5, 2)
  rank        Int?
  explanation Json
  publishedAt DateTime
  player      Player    @relation(fields: [playerId], references: [id])
  run         RatingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameId, runId])
  @@index([gameId, score(sort: Desc)])
}

model TeamRating {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @db.Uuid
  gameId      String    @db.Uuid
  runId       String    @db.Uuid
  score       Int
  confidence  Decimal   @db.Decimal(5, 2)
  rank        Int?
  explanation Json
  publishedAt DateTime
  team        Team      @relation(fields: [teamId], references: [id])
  run         RatingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([teamId, gameId, runId])
  @@index([gameId, score(sort: Desc)])
}

model Achievement {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  gameId       String?             @db.Uuid
  title        String
  description  String
  category     String
  rarity       AchievementRarity
  ruleVersion  Int                 @default(1)
  rule         Json
  icon         String
  playerGrants PlayerAchievement[]
  teamGrants   TeamAchievement[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model PlayerAchievement {
  id                String      @id @default(uuid()) @db.Uuid
  playerId          String      @db.Uuid
  achievementId     String      @db.Uuid
  progress          Decimal     @db.Decimal(12, 2)
  target            Decimal     @db.Decimal(12, 2)
  grantedAt         DateTime?
  sourceId          String?     @db.Uuid
  status            String
  evidence          Json?
  evaluationKey     String?
  verificationLevel Int         @default(0)
  firstQualifiedAt  DateTime?
  ruleVersion       Int         @default(1)
  player            Player      @relation(fields: [playerId], references: [id])
  achievement       Achievement @relation(fields: [achievementId], references: [id])
  updatedAt         DateTime    @updatedAt

  @@unique([playerId, achievementId])
}

model AchievementEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventKey    String   @unique
  eventType   String
  subjectType String
  subjectId   String   @db.Uuid
  occurredAt  DateTime
  checksum    String   @db.VarChar(64)
  payload     Json
  processedAt DateTime
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId, occurredAt])
  @@index([eventType, occurredAt])
}

model TeamAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  teamId        String      @db.Uuid
  achievementId String      @db.Uuid
  progress      Decimal     @db.Decimal(12, 2)
  target        Decimal     @db.Decimal(12, 2)
  grantedAt     DateTime?
  status        String
  team          Team        @relation(fields: [teamId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([teamId, achievementId])
}

model Transfer {
  id                String         @id @default(uuid()) @db.Uuid
  playerId          String         @db.Uuid
  fromTeamId        String?        @db.Uuid
  toTeamId          String?        @db.Uuid
  transferDate      DateTime       @db.Date
  status            TransferStatus
  sourceId          String?        @db.Uuid
  observedAt        DateTime       @default(now())
  verificationLevel Int            @default(0)
  evidence          Json?
  checksum          String         @unique @db.VarChar(64)
  player            Player         @relation(fields: [playerId], references: [id])
  fromTeam          Team?          @relation("TransferFromTeam", fields: [fromTeamId], references: [id])
  toTeam            Team?          @relation("TransferToTeam", fields: [toTeamId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, transferDate])
}

model CareerHistory {
  id                String    @id @default(uuid()) @db.Uuid
  playerId          String    @db.Uuid
  teamId            String?   @db.Uuid
  gameId            String    @db.Uuid
  role              String?
  startedAt         DateTime  @db.Date
  endedAt           DateTime? @db.Date
  sourceId          String?   @db.Uuid
  verificationLevel Int       @default(0)
  evidence          Json?
  player            Player    @relation(fields: [playerId], references: [id])
  team              Team?     @relation(fields: [teamId], references: [id])
  game              Game      @relation(fields: [gameId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([playerId, teamId, gameId, startedAt])
  @@index([playerId, startedAt])
}

model DataSource {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  type        String
  trustLevel  Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  imports     DataImport[]
  entityLinks ExternalEntityLink[]
}

model DataImport {
  id          String             @id @default(uuid()) @db.Uuid
  sourceId    String             @db.Uuid
  externalKey String?
  checksum    String
  status      DataImportStatus
  rawLocation String?
  counters    Json?
  errors      Json?
  source      DataSource         @relation(fields: [sourceId], references: [id])
  createdAt   DateTime           @default(now())
  completedAt DateTime?
  records     DataImportRecord[]

  @@unique([sourceId, checksum])
}

model DataImportRecord {
  id               String                 @id @default(uuid()) @db.Uuid
  importId         String                 @db.Uuid
  externalKey      String
  entityType       String
  checksum         String                 @db.VarChar(64)
  status           DataImportRecordStatus @default(STAGED)
  rawPayload       Json
  canonicalPayload Json?
  errors           Json?
  appliedEntityId  String?                @db.Uuid
  createdAt        DateTime               @default(now())
  appliedAt        DateTime?
  import           DataImport             @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, externalKey])
  @@unique([importId, checksum])
  @@index([status, createdAt])
}

model ExternalEntityLink {
  id          String     @id @default(uuid()) @db.Uuid
  sourceId    String     @db.Uuid
  entityType  String
  externalId  String
  entityId    String     @db.Uuid
  confidence  Int        @default(100)
  confirmedAt DateTime?
  source      DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([sourceId, entityType, externalId])
  @@index([entityType, entityId])
}

model FieldAssertion {
  id                String          @id @default(uuid()) @db.Uuid
  entityType        String
  entityId          String          @db.Uuid
  fieldPath         String
  value             Json
  sourceId          String?         @db.Uuid
  authorId          String?         @db.Uuid
  observedAt        DateTime
  verificationLevel Int             @default(0)
  status            AssertionStatus @default(CANDIDATE)
  createdAt         DateTime        @default(now())

  @@index([entityType, entityId, fieldPath, status])
}

model Verification {
  id          String                 @id @default(uuid()) @db.Uuid
  subjectType String
  subjectId   String                 @db.Uuid
  level       Int
  method      String
  status      VerificationStatus     @default(PENDING)
  reviewerId  String?                @db.Uuid
  reason      String?
  validUntil  DateTime?
  createdAt   DateTime               @default(now())
  decidedAt   DateTime?
  reviewer    User?                  @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  evidence    VerificationEvidence[]

  @@index([subjectType, subjectId, status])
}

model ProfileClaim {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @db.Uuid
  playerId        String                 @db.Uuid
  status          String                 @default("SUBMITTED")
  method          String
  statement       String?
  evidenceSummary Json?
  reviewerId      String?                @db.Uuid
  decisionReason  String?
  decidedAt       DateTime?
  claimant        User                   @relation("Claimant", fields: [userId], references: [id], onDelete: Cascade)
  player          Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)
  reviewer        User?                  @relation("ClaimReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  evidence        VerificationEvidence[]
  moderationCase  ModerationCase?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId, status, createdAt])
  @@index([playerId, status, createdAt])
}

model VerificationEvidence {
  id             String        @id @default(uuid()) @db.Uuid
  claimId        String?       @db.Uuid
  verificationId String?       @db.Uuid
  submittedById  String?       @db.Uuid
  kind           String
  reference      String
  checksum       String        @db.VarChar(64)
  visibility     String        @default("RESTRICTED")
  claim          ProfileClaim? @relation(fields: [claimId], references: [id], onDelete: Cascade)
  verification   Verification? @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  submittedBy    User?         @relation("EvidenceSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([claimId, checksum])
  @@index([verificationId])
}

model ModerationCase {
  id           String       @id @default(uuid()) @db.Uuid
  claimId      String       @unique @db.Uuid
  status       String       @default("OPEN")
  priority     Int          @default(0)
  assignedToId String?      @db.Uuid
  resolution   String?
  claim        ProfileClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("ModerationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?

  @@index([status, priority, createdAt])
  @@index([assignedToId, status])
}

model UserFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  playerId  String?  @db.Uuid
  teamId    String?  @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  topic     String
  payload   Json
  status    NotificationStatus @default(PENDING)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  @@index([userId, status, createdAt])
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  summary     String?
  body        Json
  status      ContentStatus @default(DRAFT)
  authorId    String?       @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Report {
  id         String    @id @default(uuid()) @db.Uuid
  reporterId String?   @db.Uuid
  targetType String
  targetId   String    @db.Uuid
  category   String
  details    String?
  status     String    @default("OPEN")
  resolution String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  reason     String?
  diff       Json?
  requestId  String?
  ipHash     String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
