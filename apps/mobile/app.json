{
  "expo": {
    "name": "CYBER ID",
    "slug": "cyber-id",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cyberid",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cyberid.mobile",
      "associatedDomains": ["applinks:cyber-id.example"]
    },
    "android": {
      "package": "app.cyberid.mobile",
      "adaptiveIcon": { "backgroundColor": "#090c12" },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "cyber-id.example", "pathPrefix": "/players" },
            { "scheme": "https", "host": "cyber-id.example", "pathPrefix": "/teams" },
            { "scheme": "https", "host": "cyber-id.example", "pathPrefix": "/matches" },
            {
              "scheme": "https",
              "host": "cyber-id.example",
              "pathPrefix": "/tournaments"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications", "expo-splash-screen"],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiUrl": "http://localhost:4000/api/v1",
      "canonicalWebUrl": "http://localhost:3000"
    }
  }
}
